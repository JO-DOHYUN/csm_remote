# Keep source and documentation diffs stable across Windows/Linux tools.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.xlsx binary
*.xls binary
*.docx binary
*.pptx binary
*.zip binary

# Pinned artifact manifests hash exact generated bytes, including line endings.
firmware/csm/third_party/mbed_portenta_product/artifact/**/mbed_config.h -text whitespace=cr-at-eol

# Unified-diff context uses a single-space line to represent an unchanged
# blank source line. Do not flag that patch syntax as product-source trailing
# whitespace.
firmware/csm/third_party/mbed_portenta_product/patches/*.patch whitespace=-blank-at-eol
